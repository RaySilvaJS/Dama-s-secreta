# Painel DevOps — defina uma senha segura antes de subir para produção
ADMIN_TOKEN=Natal123@@

# Telegram Bot — notificações de tráfego pago e eventos de vendas
# 1. Crie o bot: fale com @BotFather no Telegram → /newbot
# 2. Obtenha o CHAT_ID: adicione o bot ao grupo, envie uma mensagem e consulte
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mercado Pago — Checkout Bricks (Payment Brick)
# Preencha com as credenciais de TESTE do painel: https://www.mercadopago.com.br/developers/panel/app
# 1. MERCADO_PAGO_ACCESS_TOKEN → Credenciais de teste → Access Token (NUNCA exponha no frontend)
# 2. MERCADO_PAGO_PUBLIC_KEY   → Credenciais de teste → Public Key (essa sim pode ir ao frontend)
# 3. MERCADO_PAGO_WEBHOOK_SECRET → Sua integração → Webhooks → Chave secreta de assinatura
# 4. APP_URL → URL pública do site (usada para montar a notification_url do webhook)
# Sem essas 4 variáveis preenchidas, as rotas /api/payments/mercado-pago e
# /api/webhooks/mercado-pago ficam desativadas (o servidor avisa no boot).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
APP_URL=https://damassecreta.com